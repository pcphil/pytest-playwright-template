# Environment Variables for pytest-playwright tests

# Playwright configuration
HEADLESS=true
ENABLE_TRACE=false

# Working Test Environment
BASE_URL=https://www.saucedemo.com/

# Test credentials (use secure environment variables in CI, never commit secrets)
# For most cases use secrets storage such as Hashicorp Vault in your CI/CD platform
# Example:
TEST_USER_EMAIL=standard_user
TEST_USER_PASSWORD=secret_sauce

# Custom test data
# TEST_TIMEOUT=5000
